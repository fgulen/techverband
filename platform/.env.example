# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_APP_ENV=test
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Setting it turns on the contact and submit steps on /spenden (redeploy needed).
SUPABASE_SECRET_KEY=
# Optional: internal e-mail for each new request via Gmail SMTP (app password, 2FA required).
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=
